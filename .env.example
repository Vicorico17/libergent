FIRECRAWL_API_KEY=fc-your-key

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Search-only MCP prototype. Disabled unless explicitly enabled.
LIBERGENT_MCP_ENABLED=0
# Optional additional exact browser Origins, comma-separated. No wildcard.
LIBERGENT_MCP_ALLOWED_ORIGINS=
# Premium direct failures try Kitesurf first across all query-selected sources.
PREMIUM_KITESURF_ENABLED=1
PREMIUM_KITESURF_FALLBACK_LIMIT=100
PREMIUM_KITESURF_CONCURRENCY=4
# Chromium is the bounded final recovery layer for selected rendered pages.
PREMIUM_BROWSER_FALLBACK_LIMIT=8
PREMIUM_BROWSER_CONCURRENCY=3
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SEARCH_EVENTS_TABLE=search_events
SUPABASE_EMAIL_LEADS_TABLE=email_leads
SUPABASE_USER_ENTITLEMENTS_TABLE=user_entitlements
# Stripe test-mode billing. Keep keys in Worker secrets or local env, never in NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
# Two active recurring test Prices are required for new Checkout sessions.
STRIPE_WEEKLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
# Legacy 99 RON/month subscriptions can still be reconciled via this Price ID.
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
LIBERGENT_PUBLIC_URL=http://localhost:3000
SUPABASE_ALERT_PROFILES_TABLE=alert_profiles
SUPABASE_ALERT_LISTING_STATE_TABLE=alert_listing_state
SUPABASE_ALERT_EVENTS_TABLE=alert_events
SUPABASE_NOTIFICATION_DELIVERIES_TABLE=notification_deliveries
SUPABASE_DEAL_CASES_TABLE=deal_cases
SUPABASE_DEAL_SEND_ATTEMPTS_TABLE=deal_send_attempts
SUPABASE_DEAL_EVENTS_TABLE=deal_events
SUPABASE_DEAL_CALLS_TABLE=deal_calls
# Comma-separated beta testers; production should use user_entitlements instead.
LIBERGENT_PREMIUM_EMAILS=
# Vendor-neutral HTTPS endpoint accepting {to, subject, text, html, metadata}.
ALERT_EMAIL_WEBHOOK_URL=
ALERT_EMAIL_WEBHOOK_TOKEN=
LIBERGENT_MOCK_SEARCH=1
LIBERGENT_MOCK_PROVIDER=1
LIBERGENT_DEMO_CITY=București
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-R8P7G7PWR7
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dedicated Masscall pilot. Leave disabled until the isolated runtime, SQL
# migration, approved internal recipients, and recording retention are ready.
LIBERGENT_CALLING_ENABLED=0
MASSCALL_SERVICE_URL=
MASSCALL_SERVICE_TOKEN=
MASSCALL_CALLER_ID=
LIBERGENT_ALLOWED_DESTINATIONS=
LIBERGENT_CALLS_PER_DEAL_PER_DAY=1
LIBERGENT_RECORDING_RETENTION_DAYS=
OPENAI_API_KEY=
# Required with OPENAI_API_KEY for optional server-side seller-reply proposals.
DEAL_AGENT_OPENAI_MODEL=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Optional Jev decision layer for choosing among eligible Premium listings.
JEV_API_KEY=
PREMIUM_JEV_ENABLED=1
PREMIUM_JEV_MODEL=jev-latest
OPENCLAW_BRIDGE_URL=
OPENCLAW_BRIDGE_TOKEN=

# VINDE publishing: apply supabase/selling.sql first.
# Canonical public app origin; local development may use http://localhost:3000.
SELLING_PUBLIC_URL=https://libergent.com
# Generate with: openssl rand -hex 32. Store as a server secret, never NEXT_PUBLIC_*.
SELLING_ENCRYPTION_KEY=
# Request OLX partner API access; register SELLING_PUBLIC_URL/api/selling/olx/callback.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=

# External storefront integration (Worker / Durable Objects only; disabled by default).
LIBERGENT_INTEGRATIONS_ENABLED=0
# Server-only secret JSON array; see docs/storefront-integration-v1.md. Store hashes only.
LIBERGENT_INTEGRATION_KEYS=[]

# Self-service test/live developer keys; apply supabase/developer-api.sql first.
# Requires the existing server-only SUPABASE_URL and SUPABASE_SECRET_KEY.
LIBERGENT_DEVELOPER_API_ENABLED=0

# Authenticated MCP for developer-key agents, separate from the legacy /mcp prototype.
LIBERGENT_AGENT_MCP_ENABLED=0
